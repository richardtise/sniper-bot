# =============================================================================
# Pump Bot — example environment file.  Copy to .env and fill in.
#     cp .env.example .env
# NEVER commit .env; it is gitignored.
# =============================================================================

# ── Required: Telegram ───────────────────────────────────────────────────────
# Create a bot with @BotFather, then get your chat id from @userinfobot.
TELEGRAM_TOKEN=123456789:AA...your_bot_token...
CHAT_ID=000000000
# Optional: comma-separated Telegram user ids allowed to control the bot.
# If empty, only CHAT_ID is accepted. Set this if CHAT_ID is a group.
ALLOWED_USER_IDS=

# ── Optional: data providers ─────────────────────────────────────────────────
# Etherscan v2 key. One key covers every EAAS chain — including Robinhood Chain
# (chainid 4663). Used for contract verification. Get one at https://etherscan.io/apis
# SCANNER_API_KEY is accepted as an alias for this (that is the name in some
# existing deployments and it holds an Etherscan key).
ETHERSCAN_API_KEY=
# SCANNER_API_KEY=
# Moralis is OPTIONAL and no longer needed for holder concentration — holders now
# come from GeckoTerminal, which is free and keyless. Moralis is still used first
# on BSC/Ethereum/Base because it is the only source that also gives an exact
# top-100 figure. Note: the free tier is easily suspended ("usage is paused"),
# and Moralis does NOT support Robinhood Chain.
MORALIS_API_KEY=
# CoinGecko Demo key unlocks CEX-listing scoring. (Note: the letter O, not zero.)
# Robinhood tokens are not listed on CoinGecko, so this can never score there —
# the alert gate accounts for those 5 unreachable points automatically.
COINGECKO_API_KEY=

# ── Trading mode ─────────────────────────────────────────────────────────────
# true = simulate trades only (STRONGLY recommended until you trust the bot).
PAPER_TRADING=true
# Your hot wallet private key. Only needed for live trading.
# Use a dedicated wallet holding only what you are willing to lose.
WALLET_PRIVATE_KEY=
# Reject tokens whose buy/sell tax is above this %. 0 = reject any taxed token.
# Code default is 0; 10 is the recommended rollout (matches SIG_MAX_TAX_PCT).
MAX_ALLOWED_TAX=10
# Alert score threshold (0-100). Code reads MIN_SCORE first, ALERT_THRESHOLD
# only as a fallback — set MIN_SCORE, leave the alias commented.
MIN_SCORE=65
# ALERT_THRESHOLD=65

# ── Alert gate scaling ───────────────────────────────────────────────────────
# The 0-100 score is only meaningful if all 100 points are earnable, and they are
# not: holder concentration was returning nothing on every chain (Moralis free
# tier suspended, Robinhood's Blockscout Cloudflare-blocked), CEX listings can
# never score on Robinhood, and the age gates cap the long-window branches for
# young pools. With scaling on, the bar for a token is MIN_SCORE * (reachable
# points / 100), so a young Robinhood runner is not silently required to score
# 65 out of a reachable ~43. This is what produced the "no alerts at all" state.
# Set to false to gate on the raw MIN_SCORE for every chain.
SCORE_NORMALIZE=true
# Never let scaling push the bar below this, so scaling cannot turn the gate into
# a rubber stamp. Code default is 35; the example recommends 45. This floor is
# what actually gates very young pools: at age ~3m the reachable ceiling is
# ~53, so MIN_SCORE=55 scales to 29 and the floor wins.
# 35 was measured to be too permissive once new_pools was enabled — it admitted
# a token sitting at hand=35.0 exactly (a coin-flip score). 45 keeps the early
# lane's AND-gates as the way in for young pools, instead of a collapsed bar.
MIN_EFFECTIVE_SCORE=45
# Log every evaluated token, not just alerts. Noisy; useful for tuning.
# Since 2026-09-29 only ALERTS, early-lane takes and NEAR_MISS_POINTS near-misses
# log full score lines at INFO — routine signal/phase-gate rejects go to DEBUG —
# so VERBOSE_LOGGING=true is safe to leave on alongside new_pools discovery.
VERBOSE_LOGGING=true
# Tokens within this many points of the bar still log their full score line at
# INFO (tuning signal). Everything further below dies silently into the features
# table (LOG_FEATURES=true) instead of the log/chat. Raise while tuning the
# gate, lower (or 0 = alerts only) once it is trusted.
NEAR_MISS_POINTS=15
# Port for the FastAPI /health server (Render sets this automatically).
PORT=10000
# Retry Blockscout for Robinhood holders when GeckoTerminal has no data. Off by
# default: that host answers with a Cloudflare challenge (HTTP 403).
TRY_BLOCKSCOUT_HOLDERS=false

# ── RPC endpoints (public defaults are rate-limited; use your own) ───────────
ETH_RPC=https://ethereum-rpc.publicnode.com
BSC_RPC=https://bsc-dataseed.binance.org/
BASE_RPC=https://mainnet.base.org
ROBINHOOD_RPC=https://rpc.mainnet.chain.robinhood.com

# ── Wrapped native tokens (WETH / WBNB) ──────────────────────────────────────
# Code already carries working defaults for all four chains (see _HARD_WETH in
# bot.py); these lines are overrides. Your live .env must NOT be blank here —
# a blank ROBINHOOD_* line overrides the good compiled-in value with "".
ETH_WNATIVE=0xC02aaA39b223FE8D0A0e5C4F27eAD9083C756Cc2
BSC_WNATIVE=0xbb4CdB9CBd36B01bD1cBaEBF2De08d9173bc095c
BASE_WNATIVE=0x4200000000000000000000000000000000000006
ROBINHOOD_WNATIVE=0x0Bd7D308f8E1639FAb988df18A8011f41EAcAD73

# ── V3 routers ───────────────────────────────────────────────────────────────
# Same deal: compiled-in defaults work (_HARD_ROUTERS). Do NOT copy the stale
# 8-field Ethereum SwapRouter below — bot.py already corrected it to
# SwapRouter02 0x68b3465833fb72A70ecDF485E0e4C7bD8665Fc45, and an explicit
# env line would override the fix with the broken address.
# (Left commented so a fresh copy keeps the working default.)
# ETH_ROUTER_V3=0x68b3465833fb72A70ecDF485E0e4C7bD8665Fc45
BASE_ROUTER_V3=0x2626664c2603336E57B271c5C0b26F421741e481
BSC_ROUTER_V3=0x13f4EA83D0bd40E75C8222255bc855a974568Dd4
ROBINHOOD_ROUTER_V3=0xcaf681a66d020601342297493863e78c959e5cb2

# ── QuoterV2 (slippage protection) ───────────────────────────────────────────
# Same: _HARD_QUOTERS is correct. The old ETH quoter 0x...dc0b0e10 was never a
# deployed contract — keep it commented so the fixed default wins.
# ETH_QUOTER_V2=0x61fFE014bA17989E743c5F6cB21bF9697530B21e
BASE_QUOTER_V2=0x3d4e44Eb1374240CE5F1B871ab261CD16335B76a
BSC_QUOTER_V2=0xB048Bbc1Ee6b733FFfCFb9e9CeF7375518e25997
ROBINHOOD_QUOTER_V2=0x33e885ed0ec9bf04ecfb19341582aadcb4c8a9e7

# ── V2 routers (fallback when no V3 pool is found) ───────────────────────────
ETH_ROUTER_V2=0x7a250d5630B4cF539739dF2C5dAcb4c659F2488D
BSC_ROUTER_V2=0x10ED43C718714eb63d5aA57B78B54704E256024E
BASE_ROUTER_V2=0x4752ba5DBc23f44D87826276BF6Fd6b1C372aD24
ROBINHOOD_ROUTER_V2=

# ── Discovery (see discovery.py) ─────────────────────────────────────────────
# false = original DexScreener boost/profile discovery. WARNING: that path is
#   only the paid-boost shill list — the endpoint it also calls
#   (/latest/dex/pairs/{chain}) returns 404 — so on its own it can see zero
#   candidates on BSC/Ethereum/Base for hours at a time. Prefer true.
# true  = GeckoTerminal, which finds pools earlier and is the only source of the
#   unique-buyer data the AND-gates below need.
USE_GECKOTERMINAL=true
# Comma-separated GeckoTerminal sources: trending,new_pools,top_volume
#   trending   = pools that already have momentum (cleaner, a bit later)
#   new_pools  = every brand-new pool (earliest, noisiest)
#   top_volume = the liquid universe by 24h volume
#
# READ THIS BEFORE DROPPING new_pools — measured on Robinhood Chain 2026-09-29:
#   new_pools  page 1: age 3.2-5.5m, median mcap $6,663, 15/20 under $50k
#   trending   p1-3  : age 234m-133,194m (median ~31 DAYS), median mcap $3.5M,
#                      41/60 over $1M
#   top_volume p1    : median age 24h, median mcap $12.4M
# trending and top_volume are *lagging* feeds: the youngest pool trending can
# offer is hours old and already >$300k. Running them alone makes a sub-50k
# entry mathematically impossible — no amount of filter tuning can help,
# because the pool is only ever discovered after the move. new_pools is the
# only feed that carries a pool while it is still minutes old and tiny.
#
# WHY new_pools IS NOW ON EVERY CHAIN (it was Robinhood-only until 2026-09-30).
# It had been switched off on BSC after an "alert preview" of 20 births showed
# template-liquidity placeholders. That is the same error as tuning a floor on
# two tokens: a 20-pool sample used to switch off the only early feed. The right
# fix is to keep the early feed on every chain and let the FILTERS do the work,
# per chain, from each chain's own measured population — which is what the
# <CHAIN>_SIG_EARLY_* overrides below now do (BSC's p90 birth liquidity is
# ~$14.6k vs Robinhood's ~$5.4k, so BSC becomes objectively the stricter lane
# without going blind).
#
# COST/COUPLING, so this is a deliberate choice rather than a surprise:
#   * budget: with GT_PAGES_TRENDING=1 (see below) this costs ~6.7 calls per 30s
#     cycle against the shared ~30/min limiter (~14s of paced calls) — slightly
#     more than the old Robinhood-only config (~5.7) and comfortably inside the
#     interval. Putting trending back to 2 pages costs ~2s more per cycle.
#   * venues: the earliest feed is mostly unroutable today — measured on
#     new_pools page 1, 0% of Robinhood / 25% of Base / 10% of BSC / 10% of
#     Ethereum pools can be executed by the configured routers; the rest is
#     Uniswap V4 and non-Uniswap/Pancake V3 forks. Enabling new_pools everywhere
#     therefore produces more "No route" alerts until V4 execution exists. That
#     is informative, not an error, but it is the real limit on acting early.
GT_SOURCES=new_pools,trending,top_volume
# Per-chain override, same convention as the floors: GT_SOURCES_<CHAIN> wins,
# then <CHAIN>_GT_SOURCES (the repo prefix style). Use it to drop a feed on one
# chain — never to blind the early lane globally. Example, a quiet chain running
# births only:
#   GT_SOURCES_ETHEREUM=new_pools
# Pages walked per source, per chain, per cycle. Freshness is worth paying for
# only where it buys something: page 1 of new_pools IS the newest birth cohort
# (page 2 is 5-7m old, page 3 is 7-9m), while trending rewards a second page.
# Every page is one call against the shared ~30/min budget below.
# trending is 1 page now that new_pools (the early feed) runs on every chain:
# the second trending page was buying lagging $3.5M-median pools that the
# MAX_MARKET_CAP_USD ceiling rejects anyway, and the budget is better spent on
# births. Raise it back only if you drop the ceiling.
GT_PAGES_NEW=1
GT_PAGES_TRENDING=1
GT_PAGES_TOP=1
# Per-source list cache TTLs (seconds). new_pools churns a whole cohort every
# few minutes — a 90s blanket TTL skips births. top_volume barely changes, so
# a long TTL there saves budget for holder info calls.
GT_LIST_TTL_NEW=30
GT_LIST_TTL_TRENDING=60
GT_LIST_TTL_TOP=180
# GeckoTerminal's free tier allows roughly 30 calls/minute and answers a burst
# with HTTP 429. Discovery and holder lookups share this one budget; the default
# is ~28/min. Lower it only if you still see 429s, raise it only if you have a
# paid GT plan.
GT_MIN_INTERVAL_S=2.1

# ── Signal engine ────────────────────────────────────────────────────────────
# Turn the engine on. Without this, signals.py is never called and the unique
# buyer / wash-trade / concentration filters below do nothing at all.
USE_SIGNALS=true

# ── How much the signal engine may PROMOTE a token (0.0 - 1.0) ───────────────
# Code default is 0.0 (signals only veto; the hand-tuned score stays the gate).
# The example recommends 0.5 as the starting compromise.
#
# The gate is: hand_score - signal_penalty + signal_bonus * THIS >= threshold.
#
# At 0.0 (default) signals can only VETO: the hand-tuned score alone decides, so
# a token the scorer dislikes can never alert on signal strength. That is the
# conservative setting.
#
# Raising it lets the runner signals (volume acceleration, unique buyers, LP
# lock, holder stance) rescue a token the hand score under-rates. Measured on a
# real 27-day-old Robinhood pool that had gone dormant and then ran +40,605% in
# 24h: hand 42, signal +26/-13, threshold 58 -> rejected at 0.0 and still
# rejected at 1.0, because the hand component is what the bar is set against.
# It alerted only when combined with a lower per-chain threshold (see
# ROBINHOOD_MIN_SCORE above): MIN_SCORE=45 + weight 1.0 -> score 54 vs bar 40.2.
#
# WARNING: pass 2 of this repo had to be reverted because an additive bonus let
# weak tokens through and flooded Base with junk. Raising this re-opens exactly
# that vector. Raise it in small steps and watch the alerts before trusting it.
#
# The general mechanism, which is why this is worth a non-zero value: a clean,
# distributed runner earns 0 holder points and 0 CEX points on Robinhood, so its
# hand score cannot reach a bar scaled for a concentrated one. Measured on a
# Robinhood ignition (hand ~45, signal +26/-8, bar 48.6): 0.0 scores 37 and dies
# below_threshold; 1.0 scores 63 and alerts. Every value in between was checked
# against that case; 0.5 is the midpoint, not a fitted optimum. Re-fit it from
# labelled `features` rows before treating it as calibrated.
SIGNAL_BONUS_WEIGHT=0.5

# `pump` (default) rewards concentrated supply for early runners; `rug` penalises
# it. Thresholds below are the strict originals — do not loosen them if you are
# fighting noise.
SIG_HOLDER_STANCE=pump
SIG_MIN_LIQUIDITY_USD=8000
SIG_MIN_VOL_5M_USD=500
SIG_MIN_AGE_MINUTES=3
# NO upper age limit (0 = disabled). Pool age is not a quality signal: a pool can
# be old and dead, or old and freshly re-ignited by a catalyst, and only the
# activity floors below can tell those apart. The previous 5-day cap silently
# discarded the second kind — across 122 live pools, 91 were older than 5 days
# and 4 were rejected on age alone, including a 27-day-old pool up 40,605% in
# 24h and an 8-day-old one up 2,533%. Set a number to restore a hard cap
# (e.g. SIG_MAX_AGE_MINUTES=7200 for the old 5-day behaviour).
SIG_MAX_AGE_MINUTES=0
SIG_MIN_TXNS_5M=8
SIG_MAX_AVG_TRADE_LIQ=0.10
SIG_MAX_TAX_PCT=10
SIG_MIN_HOLDERS=50
SIG_REQUIRE_LP_LOCKED=false
# Require the contract source to be verified before a token may alert. Default
# false: most Robinhood Chain tokens publish no verified source, including the
# ones that actually run, and verification status depends entirely on which
# explorer answers (Blockscout is Cloudflare-blocked; Etherscan tells the truth).
# Leaving this true rejected every Robinhood token outright.
SIG_REQUIRE_OPEN_SOURCE=false
SIG_MAX_BONUS=45
SIG_MAX_PENALTY=50
# AND-gates that only apply when GeckoTerminal supplies the data — these are the
# filters DexScreener cannot give you. `buyers` is unique wallets, not tx count.
SIG_MIN_VOL_LIQ=0.05                 # 5m volume must be >=5% of liquidity
SIG_MIN_UNIQUE_BUYER_RATIO=0.50      # unique buyers / total buys
# Rug-mode only:
# SIG_MAX_TOP10_PCT=60
# SIG_MAX_CREATOR_PCT=5

# ── Early-runner fast lane (needs USE_SIGNALS + USE_GECKOTERMINAL) ───────────
# A pool younger than its 1h/6h/24h windows can never reach MIN_SCORE, so it is
# invisible to the normal gate. This lane lets a young pool alert ONLY if every
# condition below holds (AND, not a sum, so a rug cannot compensate). This is
# how you get "runners faster" without turning the bot into a firehose.
#
# MUST BE true for any early entry at all. With it false, a sub-50k-mcap pool
# is structurally unable to alert: the momentum gate needs windows that do not
# exist yet on a 3-minute-old pool.
EARLY_RUNNER_MODE=true

# ── How these floors were set (no token is referenced anywhere below) ────────
# Derived from the population the lane actually receives, by
# diag/population_floors.py — and chosen against the JOINT pass rate, because
# these gates are ANDed together.
#
# THE TRAP THIS AVOIDS: setting each metric at its own p90 does NOT select the
# top decile. Measured on the Robinhood birth cohort, five independent p90
# thresholds clear only 0.71% of births, and the pooled cohort cleared none at
# all. The lane was effectively closed without looking closed, because every
# individual number was defensible in isolation.
#
# So ONE common quantile level is chosen such that the share of births passing
# EVERY gate hits a target volume. At a 2% target that is level 0.86:
#
#   bot-env/bin/python diag/population_floors.py \
#       --chains robinhood --sources new_pools --pages 6 --target-pass-rate 0.02
#
# Measured 2026-09-30, n=80, target 2% -> achieved 2.50% of births through ALL
# gates. The independent-p90 version achieved 0.71%, roughly 4x too strict.
#
#   metric        independent p90   joint (level 0.86)
#   liquidity            $5,650            $5,697
#   vol / liq             0.202             0.070
#   txns 5m                  26                13
#   buy ratio             0.602             0.561
#   buyers 5m                11                 6
#
# The population is mostly DEAD — median txns, buyers and vol/liq are all zero —
# so any floor above ~p75 selects a small tail and the level IS the alert-volume
# policy. At 2% of Robinhood births that is roughly a handful of early-lane
# alerts per hour; lower --target-pass-rate (e.g. 0.01) for fewer.
# Outcomes are still required to choose it properly: diag/fit_thresholds.py
# refuses to fit below 30 positives across 30 tokens, and the table is empty.
SIG_EARLY_MAX_AGE_MINUTES=30
# NOT derived: pool age in new_pools is censored by feed depth (observed 12-16m
# at 2 pages), so a quantile of it is meaningless. 30 is a deliberate, inactive
# cap — the feed stops offering young pools well before it. Set it from the feed
# window you actually scan if you paginate deeper.
SIG_EARLY_MIN_LIQUIDITY_USD=5700
SIG_EARLY_MIN_VOL_LIQ=0.070
# txns and unique buyers are the real rug guards (AND-terms, so volume alone
# cannot qualify a pool): they separate a distributed buy-in from one wallet
# cycling funds.
SIG_EARLY_MIN_TXNS_5M=13
SIG_EARLY_MIN_BUY_RATIO=0.561
SIG_EARLY_MIN_UNIQUE_BUYERS=6

# ── Per-chain early floors (<CHAIN>_SIG_EARLY_*) ─────────────────────────────
# The global values above are the Robinhood cohort. Per-chain because the
# population differs by an order of magnitude: at the same joint target (2% of
# births through every gate) a BSC birth needs ~$13.6k liquidity while a
# Robinhood one needs ~$5.7k. One global floor is therefore spam on one chain or
# blindness on the other.
#
# Derived the same JOINT way (2026-09-30), which is why the BSC numbers are not
# the Robinhood ones scaled up — the metrics correlate differently per chain:
#   robinhood  n=80  level 0.86 -> 2.50% joint
#   bsc        n=40  level 0.92 -> 2.50% joint
#   base       n=15  -> NO override: the p90 liquidity CI spans $14.5k-$544k, so
#                       any value here would be invented
#   ethereum    n=2  -> NO override: not a sample
# Both fall back to the global values, which is correct behaviour, not a gap.
#
# This is the "no BSC spam" mechanism: an objective, BSC-derived joint floor,
# instead of switching off the only early feed on that chain.
BSC_SIG_EARLY_MIN_LIQUIDITY_USD=13600
BSC_SIG_EARLY_MIN_VOL_LIQ=0.045
BSC_SIG_EARLY_MIN_TXNS_5M=8
BSC_SIG_EARLY_MIN_BUY_RATIO=0.74
BSC_SIG_EARLY_MIN_UNIQUE_BUYERS=5
# Re-derive for any chain once its cohort has enough rows (joint, not per-metric):
#   bot-env/bin/python diag/population_floors.py \
#       --chains bsc --sources new_pools --pages 6 --target-pass-rate 0.02
SIG_EARLY_MAX_CHG_5M=150
SIG_EARLY_REQUIRE_UNIQUE_BUYERS=true

# Per-chain threshold overrides — the direct knob for a noisy chain, e.g.:
# BASE_MIN_LIQUIDITY_USD=25000
# BASE_MIN_VOL_5M_USD=2500
# BASE_MIN_MARKET_CAP_USD=50000
# Robinhood's bar is lower because of the score's structure, not because of any
# one token: a distributed-clean Robinhood runner holds top10 ~16%, which earns
# 0 of the 16 holder points, and Robinhood tokens are never on CoinGecko, so 0
# of the 5 CEX points are reachable either. Normalised, a 65 bar over a ~48-58
# ceiling is unreachable by the profile this bot is hunting. 55 keeps the bar
# honest without rubber-stamping it; the signal bonus does the rest.
# Re-derive per chain from labelled `features` rows when you have them.
ROBINHOOD_MIN_SCORE=55

# ── Alert ceiling: stop pinging entries that are already too late ────────────
# A mcap FLOOR keeps dust out; without a CEILING the scanner happily alerts on
# $3M and $22M tokens that have already run. Code default is 0 = disabled, so
# behaviour is unchanged until you set it. 200000 is the "early entries only"
# setting from the measured rollout.
#   MAX_MARKET_CAP_USD=200000
# Per-chain override, same convention as the floors above:
#   ROBINHOOD_MAX_MARKET_CAP_USD=200000
# TRADE-OFF: on Robinhood, trending/top_volume pools have a median mcap of
# $3.5M/$12.4M, so a 200k ceiling makes the *momentum* lane essentially silent
# there and leaves alerts to the early lane. That is the intended trade for
# early entries, but it does mean giving up the occasional late momentum catch.
# Verified 2026-09-29: with new_pools + this ceiling + MIN_EFFECTIVE_SCORE=45,
# the RH births that alerted were $19.8k and $33.5k at 3.2 minutes old, and the
# $1.9M-class ping BSC's new_pools produced is rejected.
MAX_MARKET_CAP_USD=200000

# ── Ignition watchlist: re-price pools that dropped out of the feeds ──────────
# new_pools only carries ~the last 20 minutes of births; trending only lists
# pools already hot. A pool that is born quiet and then runs hours or days later
# is never looked at again without this lane, which remembers seen pools and
# re-prices the once-promising ones on a timer via DexScreener single-pair
# lookups (a different provider, so no GT budget cost).
#
# The shape this targets, stated generally: a pool discovered while quiet, that
# drops out of every feed, and re-ignites much later. It was added after a
# measured case of exactly that (a pool that ran six days after creation), but
# the lane keys on the shape — remember + re-price on a TTL — not on that token.
WATCHLIST_ENABLED=true
WATCHLIST_MAX=40
WATCHLIST_TTL_HOURS=24
WATCHLIST_RECHECK_MINUTES=5
WATCHLIST_MIN_BEST_SCORE=20

# Accept a honeypot.is record when GoPlus has no data. OFF (default) drops
# unknown tokens, matching the original bot. Turning it on lets brand-new
# unverified tokens through — a major noise source.
ALLOW_SECURITY_FALLBACK=false

# GoPlus is the security source on BSC/ETH/Base, and it does not index a pool
# the moment it is born. Until it does, `get_token_security` returns None and the
# token is dropped as `security_unknown` — which is why a minutes-old runner can
# clear every other gate and still never alert. Set ALLOW_SECURITY_FALLBACK=true
# to accept honeypot.is instead *only* when it actually simulated the token
# (simulationSuccess + honeypotResult); otherwise the token is still dropped.
# Watch /health's `security_unknown_rejects` to see how often this bites.
#
# Robinhood is different: there is no GoPlus coverage and no honeypot.is chain
# id, so no honeypot/tax check runs at all there. Security comes from Etherscan
# (contract verification) and an unverified token is only penalised, not dropped.

# ── Tradeable venues (Uniswap V4 and other DEXes) ────────────────────────────
# A router only routes pools from its OWN factory, so the bot can execute on a
# DEX only if it holds that DEX's router. Uniswap V4 is not reachable through a
# V3 router at all — it needs the Universal Router + Permit2, which this bot
# does not implement.
#
# Measured 2026-09-30 on GeckoTerminal page 1 (20 pools per feed) — the share of
# pools the configured routers can actually execute on:
#   robinhood new_pools   0%   (pons-v2 14/20, uniswap-v4 6/20)
#   base      new_pools  25%   (uniswap-v4 8/20, bankr 4, aerodrome 2, o1 1)
#   bsc       new_pools  10%   (uniswap-v4 14/20, four-meme 4)
#   eth       new_pools  10%   (uniswap-v4 18/20)
# So the earliest feed on every chain is mostly unroutable today.
#
# Default (false): still alert, but the alert names the DEX, says there is no
# route, and withholds the buy buttons instead of offering ones that fail.
# true: reject such pools before any enrichment budget is spent on them. Note
# this silences Robinhood's early lane entirely at 0% routable.
REQUIRE_TRADEABLE_VENUE=false
# Override the recognised DEX patterns (regex, matched against the feed's dexId)
# when you add a router for another venue. Global or per chain, e.g.:
#   TRADEABLE_DEXES=aerodrome|uniswap
#   BASE_TRADEABLE_DEXES=uniswap|aerodrome
# Leave unset to use the built-in per-chain defaults (uniswap v2/v3 on
# eth/base/robinhood, pancakeswap v2/v3 on bsc).

# ── Trading safety / cost knobs ──────────────────────────────────────────────
# Code defaults: APPROVAL_MULTIPLIER=1.0, MAX_GAS_PRICE_GWEI=500,
# PAPER_FEE_PCT=1.0 — the lines below pin them explicitly.
# ERC-20 approval amount = sell amount x this. 1.0 approves exactly what the
# current sell needs (safest). Raise it to reduce approval txs, accepting a
# larger standing allowance that a router bug could drain.
APPROVAL_MULTIPLIER=1.0
# Gas-price ceiling in gwei (0 disables). Prevents paying absurd fees during a
# base-fee spike. Uses EIP-1559 when the chain supports it, legacy otherwise.
MAX_GAS_PRICE_GWEI=500
# Paper trading models a fee per side (%) so paper P&L is not fiction.
PAPER_FEE_PCT=1.0

# ── Feature logging for model training (Phase 2) ─────────────────────────────
# Code default is false (no disk growth); the example turns it ON because the
# table is the tuning signal now that rejects log near-misses only.
# Log a rich feature row for EVERY token evaluation (not only alerts) to the
# `features` table. ON in the example because rejects now log near-misses only —
# the table is the tuning signal, not the log file. Disk-bounded (Phase 2 docs).
LOG_FEATURES=true
# Optional: write features to a different SQLite file than the bot state.
# FEATURE_DB_PATH=features.db

